// Clock onboard input (50MHz PLL source)
IO_LOC "clk_in" 33;
IO_PORT "clk_in" IO_TYPE=LVCMOS33;

// Push Buttons (Active Low)
IO_LOC "btn_1" 14;
IO_PORT "btn_1" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC "btn_2" 15;
IO_PORT "btn_2" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// PWM LED Output
IO_LOC "led_pwm" 10;
IO_PORT "led_pwm" IO_TYPE=LVCMOS33;

// UART Transmitter Output
IO_LOC "uart_tx" 16;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
